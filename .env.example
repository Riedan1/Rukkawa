# ==============================================================================
# YUME NETWORK — ENVIRONMENT VARIABLES CONFIGURATION
# See docs/ENVIRONMENT_VARIABLES_REGISTRY.md for complete classification,
# default behaviors, fail-closed security rules, and deployment dependencies.
#
# POLICY: Production secrets, real DB URLs, hardware endpoints, and measured
# network values are intentionally DEFERRED until staging/production rollout.
# Never weaken security flags (e.g., YUME_REQUIRE_POSITIVE_STONITH) to bypass
# unprovisioned hardware.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DEVELOPMENT_REQUIRED (Safe defaults for local & sandbox development)
# ------------------------------------------------------------------------------
# Explicit storage posture: "local_hardened" (dev/sandbox) or "postgres16" (staging/prod).
# WARNING: local-db.json is strictly non-production; production MUST use "postgres16".
DB_AUTHORITY="local_hardened"

# Express runtime mode ("development" for Vite middleware, "production" for dist/server.cjs)
NODE_ENV="development"

# Disable Vite HMR/chokidar inside hosted AI Studio preview containers
DISABLE_HMR="false"

# Optional override for local JSON store path (defaults to ./data; tests use temp dir)
YUME_DATA_DIR=""

# CRITICAL SAFETY INVARIANTS (MUST NEVER be weakened or bypassed in any stage)
YUME_REQUIRE_POSITIVE_STONITH="true"
YUME_ALLOW_CROSS_BORDER_PII_REPLICATION="false"

# ------------------------------------------------------------------------------
# 2. STAGING_REQUIRED (Deferred during feature dev — leave unset until staging)
# ------------------------------------------------------------------------------
# Authoritative PostgreSQL 16 core database (yume_core_db via PgBouncer/WireGuard)
DATABASE_URL=""

# Separate Sovereign Regional PII Vault PostgreSQL instance (e.g., Algeria port 5433)
PII_VAULT_DATABASE_URL=""

# Cryptographic secrets (dev uses local data/.security/*.key; multi-node requires injected secrets)
YUME_BACKUP_KMS_KEY=""
YUME_ADMIN_SESSION_SECRET=""

# Deterministic UUIDv5 namespace UUID for PII Vault tokenization (yume_pii_vault_dz)
YUME_PII_NAMESPACE_DZ=""

# Portable Cloudflare R2 & Edge CDN endpoints (leave unset in dev; server uses documented non-live placeholders)
YUME_R2_BUCKET_URL=""
YUME_R2_DR_VAULT_URL=""
YUME_CDN_BASE_URL=""

# Cluster node & region placement identifiers (dev placeholders only; set real host IDs in staging/prod)
YUME_NODE_ID="dev-local-primary"
YUME_REGION_CODE="dz-algiers-1"
YUME_STANDBY_NODE_ID="dev-local-standby"
YUME_STANDBY_REGION_CODE="eu-fra-01"

# ------------------------------------------------------------------------------
# 3. PRODUCTION_REQUIRED (Deferred until bare-metal / production go-live)
# ------------------------------------------------------------------------------
# Empirical evening peak (19:00-23:00 CET) measured FTTH upload in Mbps (50 | 100 | 200).
# Leave empty until measured via iperf3/flent; never treat theoretical defaults as measured capacity.
YUME_MEASURED_FTTH_UPLOAD_MBPS=""

# Canonical public HTTPS URL injected by Cloud Run / production reverse proxy
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# 4. OPTIONAL_INTEGRATION (Graceful local fallback when empty/unset)
# ------------------------------------------------------------------------------
# Gemini AI API Key (falls back to deterministic JSON responses when unset or placeholder)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Algerian Courier APIs (adapters run cleanly in sandbox mode when unset)
YALIDINE_API_ID=""
YALIDINE_API_TOKEN=""
ZR_EXPRESS_TOKEN=""

# Optional Image / Media Services
REMOVE_BG_API_KEY=""
CLOUDINARY_URL=""
