rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'th3p2000@gmail.com' ||
        request.auth.token.email == 'th3p2014@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidPlatformAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'actorUid', 'actorEmail', 'actorRole', 'module', 'action', 'targetEntityType', 'targetEntityId', 'marketScope', 'reason', 'integrityHash'])
        && data.keys().hasOnly(['id', 'timestamp', 'actorUid', 'actorEmail', 'actorRole', 'module', 'action', 'targetEntityType', 'targetEntityId', 'marketScope', 'reason', 'integrityHash'])
        && isValidId(data.id)
        && data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64
        && data.actorUid is string && data.actorUid.size() >= 1 && data.actorUid.size() <= 128 && data.actorUid == request.auth.uid
        && data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254
        && data.actorRole is string && data.actorRole.size() >= 1 && data.actorRole.size() <= 64
        && data.module is string && data.module.size() >= 1 && data.module.size() <= 64
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 128
        && data.targetEntityType is string && data.targetEntityType.size() >= 1 && data.targetEntityType.size() <= 64
        && data.targetEntityId is string && data.targetEntityId.size() >= 1 && data.targetEntityId.size() <= 128
        && data.marketScope is string && data.marketScope.size() >= 1 && data.marketScope.size() <= 32
        && data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 500
        && data.integrityHash is string && data.integrityHash.size() >= 1 && data.integrityHash.size() <= 128;
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'photoURL', 'authProvider', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'authProvider', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254 && data.email == request.auth.token.email
        && data.photoURL is string && data.photoURL.size() <= 1024
        && data.authProvider is string && data.authProvider.size() <= 32 && (data.authProvider == 'google' || data.authProvider == 'password')
        && data.updatedAt == request.time;
    }

    // Validation Blueprint: Wishlist (/wishlists/{userId})
    function isValidWishlist(data) {
      return data.keys().hasAll(['productIds', 'updatedAt'])
        && data.keys().hasOnly(['productIds', 'updatedAt'])
        && data.productIds is list && data.productIds.size() <= 200
        && (data.productIds.size() == 0 || (data.productIds[0] is string && data.productIds[0].size() <= 128))
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: MainCategory (/categories/{categoryId})
    function isValidMainCategory(data) {
      return data.keys().hasAll(['id', 'names', 'icon', 'image', 'order'])
        && data.keys().hasOnly(['id', 'names', 'icon', 'image', 'order', 'isArchived'])
        && isValidId(data.id)
        && data.names is map && data.names.keys().size() <= 10
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 128
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 1024
        && data.order is int && data.order >= 0 && data.order <= 10000
        && (!('isArchived' in data) || data.isArchived is bool);
    }

    // Validation Blueprint: Subcategory (/subcategories/{subcategoryId})
    function isValidSubcategory(data) {
      return data.keys().hasAll(['id', 'mainCategoryId', 'names', 'icon', 'image', 'order', 'sizeSystem', 'recommendedMaterials', 'fields'])
        && data.keys().hasOnly(['id', 'mainCategoryId', 'names', 'icon', 'image', 'order', 'isArchived', 'sizeSystem', 'recommendedMaterials', 'fields'])
        && isValidId(data.id)
        && isValidId(data.mainCategoryId)
        && data.names is map && data.names.keys().size() <= 10
        && data.icon is string && data.icon.size() >= 1 && data.icon.size() <= 128
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 1024
        && data.order is int && data.order >= 0 && data.order <= 10000
        && (!('isArchived' in data) || data.isArchived is bool)
        && data.sizeSystem is map && data.sizeSystem.keys().size() <= 10
        && data.recommendedMaterials is list && data.recommendedMaterials.size() <= 100
        && (data.recommendedMaterials.size() == 0 || (data.recommendedMaterials[0] is string && data.recommendedMaterials[0].size() <= 128))
        && data.fields is list && data.fields.size() <= 50;
    }

    // Validation Blueprint: Brand (/brands/{brandId})
    function isValidBrand(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'models'])
        && data.keys().hasOnly(['id', 'name', 'category', 'models'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 128
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 128
        && data.models is list && data.models.size() <= 200
        && (data.models.size() == 0 || (data.models[0] is string && data.models[0].size() <= 128));
    }

    // Validation Blueprint: PendingModel (/pending_models/{pendingModelId})
    function isValidPendingModel(data) {
      return data.keys().hasAll(['id', 'brandId', 'brandName', 'modelName', 'status', 'submittedAt'])
        && data.keys().hasOnly(['id', 'brandId', 'brandName', 'modelName', 'status', 'submittedAt'])
        && isValidId(data.id)
        && isValidId(data.brandId)
        && data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 128
        && data.modelName is string && data.modelName.size() >= 1 && data.modelName.size() <= 128
        && data.status is string && data.status.size() <= 32 && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && data.submittedAt is string && data.submittedAt.size() >= 1 && data.submittedAt.size() <= 64;
    }

    // 1. User Profiles (PII Isolated strictly to Owner or Admin)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() || (
          request.auth.uid == userId
          && incoming().uid == existing().uid
          && incoming().email == existing().email
          && incoming().authProvider == existing().authProvider
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt'])
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Wishlists (Strictly scoped to Owner)
    match /wishlists/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidWishlist(incoming());
      allow update: if isSignedIn() && isValidId(userId) && isValidWishlist(incoming()) && (
        request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['productIds', 'updatedAt'])
      );
      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 3. Main Categories (Public catalog read, Admin write)
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if resource.data.order >= 0;
      allow create: if isAdmin() && isValidId(categoryId) && incoming().id == categoryId && isValidMainCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidMainCategory(incoming()) && incoming().id == existing().id && (
        incoming().diff(existing()).affectedKeys().hasOnly(['names', 'icon', 'image', 'order', 'isArchived'])
      );
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    // 4. Subcategories (Public catalog read, Admin write)
    match /subcategories/{subcategoryId} {
      allow get: if isValidId(subcategoryId);
      allow list: if resource.data.order >= 0;
      allow create: if isAdmin() && isValidId(subcategoryId) && incoming().id == subcategoryId && isValidSubcategory(incoming()) && exists(/databases/$(database)/documents/categories/$(incoming().mainCategoryId));
      allow update: if isAdmin() && isValidId(subcategoryId) && isValidSubcategory(incoming()) && incoming().id == existing().id && (
        incoming().diff(existing()).affectedKeys().hasOnly(['mainCategoryId', 'names', 'icon', 'image', 'order', 'isArchived', 'sizeSystem', 'recommendedMaterials', 'fields'])
      );
      allow delete: if isAdmin() && isValidId(subcategoryId);
    }

    // 5. Brands (Public catalog read, Admin write)
    match /brands/{brandId} {
      allow get: if isValidId(brandId);
      allow list: if resource.data.name >= '';
      allow create: if isAdmin() && isValidId(brandId) && incoming().id == brandId && isValidBrand(incoming());
      allow update: if isAdmin() && isValidId(brandId) && isValidBrand(incoming()) && incoming().id == existing().id && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'models'])
      );
      allow delete: if isAdmin() && isValidId(brandId);
    }

    // 6. Pending Models (Authenticated users submit 'pending', Admin reviews)
    match /pending_models/{pendingModelId} {
      allow get: if isAdmin() && isValidId(pendingModelId);
      allow list: if isAdmin() && (resource.data.status == 'pending' || resource.data.status == 'approved' || resource.data.status == 'rejected');
      allow create: if isSignedIn() && isValidId(pendingModelId) && incoming().id == pendingModelId && isValidPendingModel(incoming()) && incoming().status == 'pending' && exists(/databases/$(database)/documents/brands/$(incoming().brandId));
      allow update: if isAdmin() && isValidId(pendingModelId) && isValidPendingModel(incoming()) && existing().status == 'pending' && incoming().id == existing().id && incoming().brandId == existing().brandId && incoming().submittedAt == existing().submittedAt && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status'])
      );
      allow delete: if isAdmin() && isValidId(pendingModelId);
    }

    // 7. Global Markets Configuration (Public read, Platform Admin write)
    match /markets/{marketId} {
      allow get: if isValidId(marketId);
      allow list: if resource.data.isActive == true || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(marketId);
    }

    // 8. Market-Scoped Campaigns (Public read for active campaigns, Owner/Admin write)
    match /campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if resource.data.status == 'active' || isAdmin();
      allow create, update: if isSignedIn() && isValidId(campaignId) && (
        isAdmin() || (incoming().level == 'merchant_store' && incoming().ownerStoreId is string && incoming().ownerStoreId.size() >= 1)
      );
      allow delete: if isSignedIn() && isValidId(campaignId) && isAdmin();
    }

    // 9. Platform Audit Logs & Governance Audit Ledger (Strictly append-only, Admin read/create, zero update/delete)
    match /platform_audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isAdmin() && resource.data.id >= '';
      allow create: if isAdmin() && isValidId(logId) && incoming().id == logId && isValidPlatformAuditLog(incoming());
      allow update, delete: if false;
    }

    match /governanceAuditLedger/{entryId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(entryId);
      allow update, delete: if false;
    }

    match /governance_checkpoints/{checkpointId} {
      allow get, list: if isAdmin();
      allow create: if isAdmin() && isValidId(checkpointId);
      allow update, delete: if false;
    }

    // =========================================================================
    // PARTNER PICKS — RECIPROCAL MERCHANT COLLABORATION SECURITY RULES
    // (100% independent from paid advertising, campaigns, CPC/CPM, and billing)
    // =========================================================================

    function isValidPartnerPickChannelId(ch) {
      return ch is string && ch.size() <= 32 && (
        ch == 'STORE_BANNER' ||
        ch == 'PRODUCT_GRID' ||
        ch == 'DISCOVER_MORE' ||
        ch == 'REELS_FEED' ||
        ch == 'STORIES'
      );
    }

    function isValidPartnerPicksPartnershipStatus(st) {
      return st is string && st.size() <= 32 && (
        st == 'PENDING_REQUEST' ||
        st == 'ACCEPTED' ||
        st == 'TERMS_PENDING' ||
        st == 'PLACEMENT_PENDING' ||
        st == 'ACTIVE' ||
        st == 'REJECTED' ||
        st == 'CANCELLED' ||
        st == 'EXPIRED' ||
        st == 'SUSPENDED'
      );
    }

    function isValidPlacementLifecycleState(st) {
      return st is string && st.size() <= 64 && (
        st == 'PROPOSED_AWAITING_HOST_SELECTION' ||
        st == 'HOST_SELECTED_AWAITING_FINAL_APPROVAL' ||
        st == 'APPROVED_LIVE' ||
        st == 'REJECTED_BY_HOST' ||
        st == 'REJECTED_BY_PROPOSER' ||
        st == 'AUTO_PAUSED_OUT_OF_STOCK' ||
        st == 'PAUSED_OWNER_HIDDEN' ||
        st == 'PAUSED_OWNER_DISABLED' ||
        st == 'PAUSED_OWNER_ARCHIVED' ||
        st == 'INVALIDATED_PRODUCT_REMOVED' ||
        st == 'SUSPENDED_BY_PLATFORM_ADMIN'
      );
    }

    // Validation Blueprint: PartnerPicksGlobalConfig (/partner_picks_config/{configId})
    function isValidPartnerPicksGlobalConfig(data) {
      return data.keys().hasAll([
          'id',
          'featureEnabled',
          'maxSimultaneousPartnerStores',
          'defaultRotationMode',
          'timedRotationEnabled',
          'timedRotationIntervalSeconds',
          'channels',
          'planEntitlements',
          'smartFrequency',
          'updatedAt',
          'updatedByAdminId'
        ])
        && data.keys().hasOnly([
          'id',
          'featureEnabled',
          'maxSimultaneousPartnerStores',
          'defaultRotationMode',
          'timedRotationEnabled',
          'timedRotationIntervalSeconds',
          'channels',
          'planEntitlements',
          'smartFrequency',
          'updatedAt',
          'updatedByAdminId'
        ])
        && isValidId(data.id)
        && data.featureEnabled is bool
        && data.maxSimultaneousPartnerStores is int
        && data.maxSimultaneousPartnerStores >= 1
        && data.maxSimultaneousPartnerStores <= 10
        && data.defaultRotationMode is string
        && data.defaultRotationMode.size() <= 32
        && (data.defaultRotationMode == 'REFRESH_BASED' || data.defaultRotationMode == 'TIMED_ROTATION')
        && data.timedRotationEnabled is bool
        && data.timedRotationIntervalSeconds is int
        && data.timedRotationIntervalSeconds >= 5
        && data.timedRotationIntervalSeconds <= 3600
        && data.channels is map && data.channels.keys().size() <= 10
        && data.planEntitlements is map && data.planEntitlements.keys().size() <= 10
        && data.smartFrequency is map && data.smartFrequency.keys().size() <= 15
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64
        && data.updatedByAdminId is string && data.updatedByAdminId.size() >= 1 && data.updatedByAdminId.size() <= 128;
    }

    // Validation Blueprint: MerchantPartnerPicksProfile (/partner_picks_profiles/{storeId})
    function isValidMerchantPartnerPicksProfile(data) {
      return data.keys().hasAll([
          'storeId',
          'ownerUid',
          'defaultSharedProductIds',
          'partnershipProductMode',
          'customProductIdsByPartnership',
          'hostChannelConsent',
          'hostSpatialAllowedSlots',
          'hostSequentialMediaConsent',
          'staffPermissions',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'storeId',
          'ownerUid',
          'defaultSharedProductIds',
          'partnershipProductMode',
          'customProductIdsByPartnership',
          'hostChannelConsent',
          'hostSpatialAllowedSlots',
          'hostSequentialMediaConsent',
          'staffPermissions',
          'updatedAt'
        ])
        && isValidId(data.storeId)
        && isValidId(data.ownerUid)
        && data.defaultSharedProductIds is list && data.defaultSharedProductIds.size() <= 100
        && (data.defaultSharedProductIds.size() == 0 || (data.defaultSharedProductIds[0] is string && data.defaultSharedProductIds[0].size() <= 128))
        && data.partnershipProductMode is map && data.partnershipProductMode.keys().size() <= 100
        && data.customProductIdsByPartnership is map && data.customProductIdsByPartnership.keys().size() <= 100
        && data.hostChannelConsent is map && data.hostChannelConsent.keys().size() <= 10
        && data.hostSpatialAllowedSlots is map && data.hostSpatialAllowedSlots.keys().size() <= 10
        && data.hostSequentialMediaConsent is map && data.hostSequentialMediaConsent.keys().size() <= 10
        && data.staffPermissions is map && data.staffPermissions.keys().size() <= 10
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: PartnerPicksPartnership (/partner_picks_partnerships/{partnershipId})
    function isValidPartnerPicksPartnership(data) {
      return data.keys().hasAll([
          'id',
          'storeAId',
          'storeAName',
          'storeAOwnerUid',
          'storeBId',
          'storeBName',
          'storeBOwnerUid',
          'initiatedByStoreId',
          'status',
          'agreementTerms',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'storeAId',
          'storeAName',
          'storeAOwnerUid',
          'storeBId',
          'storeBName',
          'storeBOwnerUid',
          'initiatedByStoreId',
          'status',
          'requestMessage',
          'agreementTerms',
          'activatedAt',
          'expiresAt',
          'suspendedByAdminId',
          'suspendedReason',
          'previousStatusBeforeSuspension',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.storeAId)
        && data.storeAName is string && data.storeAName.size() >= 1 && data.storeAName.size() <= 160
        && isValidId(data.storeAOwnerUid)
        && isValidId(data.storeBId)
        && data.storeBName is string && data.storeBName.size() >= 1 && data.storeBName.size() <= 160
        && isValidId(data.storeBOwnerUid)
        && data.storeAId != data.storeBId
        && isValidId(data.initiatedByStoreId)
        && (data.initiatedByStoreId == data.storeAId || data.initiatedByStoreId == data.storeBId)
        && isValidPartnerPicksPartnershipStatus(data.status)
        && (!('requestMessage' in data) || (data.requestMessage is string && data.requestMessage.size() <= 500))
        && data.agreementTerms is map && data.agreementTerms.keys().size() <= 15
        && (!('activatedAt' in data) || data.activatedAt == null || (data.activatedAt is string && data.activatedAt.size() <= 64))
        && (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64))
        && (!('suspendedByAdminId' in data) || data.suspendedByAdminId == null || (data.suspendedByAdminId is string && data.suspendedByAdminId.size() <= 128))
        && (!('suspendedReason' in data) || data.suspendedReason == null || (data.suspendedReason is string && data.suspendedReason.size() <= 500))
        && (!('previousStatusBeforeSuspension' in data) || data.previousStatusBeforeSuspension == null || isValidPartnerPicksPartnershipStatus(data.previousStatusBeforeSuspension))
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: PartnerPickProductPlacement (/partner_picks_placements/{placementId})
    function isValidPartnerPickProductPlacement(data) {
      return data.keys().hasAll([
          'id',
          'partnershipId',
          'sourceStoreId',
          'sourceStoreOwnerUid',
          'hostStoreId',
          'hostStoreOwnerUid',
          'productId',
          'channelId',
          'proposedOptions',
          'proposerFinalApproved',
          'trafficLight',
          'lifecycleState',
          'activityHistory',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'partnershipId',
          'sourceStoreId',
          'sourceStoreOwnerUid',
          'hostStoreId',
          'hostStoreOwnerUid',
          'productId',
          'channelId',
          'proposedOptions',
          'selectedOptionId',
          'selectedOption',
          'hostSelectedAt',
          'proposerFinalApproved',
          'proposerFinalApprovedAt',
          'trafficLight',
          'lifecycleState',
          'activityHistory',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.partnershipId)
        && isValidId(data.sourceStoreId)
        && isValidId(data.sourceStoreOwnerUid)
        && isValidId(data.hostStoreId)
        && isValidId(data.hostStoreOwnerUid)
        && data.sourceStoreId != data.hostStoreId
        && isValidId(data.productId)
        && isValidPartnerPickChannelId(data.channelId)
        && data.proposedOptions is list && data.proposedOptions.size() >= 1 && data.proposedOptions.size() <= 20
        && (!('selectedOptionId' in data) || data.selectedOptionId == null || isValidId(data.selectedOptionId))
        && (!('selectedOption' in data) || data.selectedOption == null || (data.selectedOption is map && data.selectedOption.keys().size() <= 12))
        && (!('hostSelectedAt' in data) || data.hostSelectedAt == null || (data.hostSelectedAt is string && data.hostSelectedAt.size() <= 64))
        && data.proposerFinalApproved is bool
        && (!('proposerFinalApprovedAt' in data) || data.proposerFinalApprovedAt == null || (data.proposerFinalApprovedAt is string && data.proposerFinalApprovedAt.size() <= 64))
        && data.trafficLight is string && data.trafficLight.size() <= 16 && (data.trafficLight == 'GREEN' || data.trafficLight == 'YELLOW' || data.trafficLight == 'RED')
        && isValidPlacementLifecycleState(data.lifecycleState)
        && (data.lifecycleState != 'APPROVED_LIVE' || (data.proposerFinalApproved == true && data.selectedOptionId != null && data.trafficLight == 'GREEN'))
        && data.activityHistory is list && data.activityHistory.size() <= 100
        && data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: PartnerPicksBidirectionalExposureLedger (/partner_picks_exposure_ledger/{partnershipId})
    function isValidPartnerPicksExposureLedger(data) {
      return data.keys().hasAll(['partnershipId', 'storeAId', 'storeBId', 'directionAOnB', 'directionBOnA', 'updatedAt'])
        && data.keys().hasOnly(['partnershipId', 'storeAId', 'storeBId', 'directionAOnB', 'directionBOnA', 'updatedAt'])
        && isValidId(data.partnershipId)
        && isValidId(data.storeAId)
        && isValidId(data.storeBId)
        && data.storeAId != data.storeBId
        && data.directionAOnB is map && data.directionAOnB.keys().size() <= 15
        && data.directionBOnA is map && data.directionBOnA.keys().size() <= 15
        && data.updatedAt is string && data.updatedAt.size() >= 1 && data.updatedAt.size() <= 64;
    }

    // Validation Blueprint: PartnerPicksChannelAnalyticsEvent (/partner_picks_analytics_events/{eventId})
    function isValidPartnerPicksAnalyticsEvent(data) {
      return data.keys().hasAll([
          'id',
          'idempotencyKey',
          'partnershipId',
          'placementId',
          'hostStoreId',
          'sourceStoreId',
          'channelId',
          'productId',
          'eventType',
          'visitorHash',
          'rotationEpoch',
          'timestamp'
        ])
        && data.keys().hasOnly([
          'id',
          'idempotencyKey',
          'partnershipId',
          'placementId',
          'hostStoreId',
          'sourceStoreId',
          'channelId',
          'productId',
          'eventType',
          'visitorHash',
          'rotationEpoch',
          'exposureDurationMs',
          'timestamp'
        ])
        && isValidId(data.id)
        && data.idempotencyKey is string && data.idempotencyKey.size() >= 6 && data.idempotencyKey.size() <= 256
        && isValidId(data.partnershipId)
        && isValidId(data.placementId)
        && isValidId(data.hostStoreId)
        && isValidId(data.sourceStoreId)
        && data.hostStoreId != data.sourceStoreId
        && isValidPartnerPickChannelId(data.channelId)
        && isValidId(data.productId)
        && data.eventType is string && data.eventType.size() <= 32 && (
          data.eventType == 'opportunity' ||
          data.eventType == 'impression' ||
          data.eventType == 'click' ||
          data.eventType == 'skip' ||
          data.eventType == 'original_product_open'
        )
        && data.visitorHash is string && data.visitorHash.size() >= 1 && data.visitorHash.size() <= 128
        && data.rotationEpoch is int && data.rotationEpoch >= 0
        && (!('exposureDurationMs' in data) || (data.exposureDurationMs is int && data.exposureDurationMs >= 0 && data.exposureDurationMs <= 3600000))
        && data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 64;
    }

    // 10. Partner Picks Global Configuration (Public read for active placement resolution, Platform Admin write)
    match /partner_picks_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if resource.data.id == 'global' || isAdmin();
      allow create: if isAdmin() && isValidId(configId) && incoming().id == configId && isValidPartnerPicksGlobalConfig(incoming());
      allow update: if isAdmin() && isValidId(configId) && isValidPartnerPicksGlobalConfig(incoming()) && incoming().id == existing().id && (
        incoming().diff(existing()).affectedKeys().hasOnly([
          'featureEnabled',
          'maxSimultaneousPartnerStores',
          'defaultRotationMode',
          'timedRotationEnabled',
          'timedRotationIntervalSeconds',
          'channels',
          'planEntitlements',
          'smartFrequency',
          'updatedAt',
          'updatedByAdminId'
        ])
      );
      allow delete: if false;
    }

    // 11. Merchant Partner Picks Profiles (Scoped to Store Owner or Platform Admin)
    match /partner_picks_profiles/{storeId} {
      allow get: if isSignedIn() && isValidId(storeId) && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(storeId) && incoming().storeId == storeId && isValidMerchantPartnerPicksProfile(incoming()) && (
        incoming().ownerUid == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && isValidId(storeId) && isValidMerchantPartnerPicksProfile(incoming()) && incoming().storeId == existing().storeId && incoming().ownerUid == existing().ownerUid && (
        isAdmin() || (
          existing().ownerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly([
            'defaultSharedProductIds',
            'partnershipProductMode',
            'customProductIdsByPartnership',
            'hostChannelConsent',
            'hostSpatialAllowedSlots',
            'hostSequentialMediaConsent',
            'staffPermissions',
            'updatedAt'
          ])
        )
      );
      allow delete: if isAdmin() && isValidId(storeId);
    }

    // 12. Partner Picks Reciprocal Partnerships (Bilateral Store A & Store B participants + Platform Admin)
    match /partner_picks_partnerships/{partnershipId} {
      allow get: if isValidId(partnershipId) && (
        resource.data.status == 'ACTIVE' ||
        (isSignedIn() && (
          resource.data.storeAOwnerUid == request.auth.uid ||
          resource.data.storeBOwnerUid == request.auth.uid ||
          isAdmin()
        ))
      );
      allow list: if resource.data.status == 'ACTIVE' || (
        isSignedIn() && (
          resource.data.storeAOwnerUid == request.auth.uid ||
          resource.data.storeBOwnerUid == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isSignedIn() && isValidId(partnershipId) && incoming().id == partnershipId && isValidPartnerPicksPartnership(incoming()) && (
        isAdmin() ||
        (incoming().initiatedByStoreId == incoming().storeAId && incoming().storeAOwnerUid == request.auth.uid && incoming().status == 'PENDING_REQUEST') ||
        (incoming().initiatedByStoreId == incoming().storeBId && incoming().storeBOwnerUid == request.auth.uid && incoming().status == 'PENDING_REQUEST')
      );
      allow update: if isSignedIn() && isValidId(partnershipId) && isValidPartnerPicksPartnership(incoming())
        && incoming().id == existing().id
        && incoming().storeAId == existing().storeAId
        && incoming().storeAOwnerUid == existing().storeAOwnerUid
        && incoming().storeBId == existing().storeBId
        && incoming().storeBOwnerUid == existing().storeBOwnerUid
        && incoming().initiatedByStoreId == existing().initiatedByStoreId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() || (
            existing().status != 'SUSPENDED'
            && (existing().storeAOwnerUid == request.auth.uid || existing().storeBOwnerUid == request.auth.uid)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status',
              'agreementTerms',
              'activatedAt',
              'expiresAt',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(partnershipId);
    }

    // 13. Partner Pick Product Placements (Enforces Two-Sided Approval & 6-State Lifecycle)
    match /partner_picks_placements/{placementId} {
      allow get: if isValidId(placementId) && (
        resource.data.lifecycleState == 'APPROVED_LIVE' ||
        (isSignedIn() && (
          resource.data.sourceStoreOwnerUid == request.auth.uid ||
          resource.data.hostStoreOwnerUid == request.auth.uid ||
          isAdmin()
        ))
      );
      allow list: if resource.data.lifecycleState == 'APPROVED_LIVE' || (
        isSignedIn() && (
          resource.data.sourceStoreOwnerUid == request.auth.uid ||
          resource.data.hostStoreOwnerUid == request.auth.uid ||
          isAdmin()
        )
      );
      allow create: if isSignedIn() && isValidId(placementId) && incoming().id == placementId && isValidPartnerPickProductPlacement(incoming()) && (
        isAdmin() || (
          incoming().sourceStoreOwnerUid == request.auth.uid
          && incoming().lifecycleState == 'PROPOSED_AWAITING_HOST_SELECTION'
          && incoming().proposerFinalApproved == false
          && incoming().trafficLight == 'YELLOW'
        )
      );
      allow update: if isSignedIn() && isValidId(placementId) && isValidPartnerPickProductPlacement(incoming())
        && incoming().id == existing().id
        && incoming().partnershipId == existing().partnershipId
        && incoming().sourceStoreId == existing().sourceStoreId
        && incoming().sourceStoreOwnerUid == existing().sourceStoreOwnerUid
        && incoming().hostStoreId == existing().hostStoreId
        && incoming().hostStoreOwnerUid == existing().hostStoreOwnerUid
        && incoming().productId == existing().productId
        && incoming().channelId == existing().channelId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          // Action 1: Host Merchant selects from proposed options or rejects proposal
          (
            existing().hostStoreOwnerUid == request.auth.uid
            && existing().lifecycleState != 'SUSPENDED_BY_PLATFORM_ADMIN'
            && incoming().proposerFinalApproved == false
            && (
              incoming().lifecycleState == 'HOST_SELECTED_AWAITING_FINAL_APPROVAL' ||
              incoming().lifecycleState == 'REJECTED_BY_HOST'
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'selectedOptionId',
              'selectedOption',
              'hostSelectedAt',
              'trafficLight',
              'lifecycleState',
              'activityHistory',
              'updatedAt'
            ])
          ) ||
          // Action 2: Source Merchant gives final approval after host selection, updates proposed options, or pauses/withdraws own product
          (
            existing().sourceStoreOwnerUid == request.auth.uid
            && existing().lifecycleState != 'SUSPENDED_BY_PLATFORM_ADMIN'
            && (
              incoming().lifecycleState != 'APPROVED_LIVE' ||
              existing().lifecycleState == 'HOST_SELECTED_AWAITING_FINAL_APPROVAL' ||
              existing().lifecycleState == 'AUTO_PAUSED_OUT_OF_STOCK'
            )
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'proposedOptions',
              'proposerFinalApproved',
              'proposerFinalApprovedAt',
              'trafficLight',
              'lifecycleState',
              'activityHistory',
              'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(placementId);
    }

    // 14. Bidirectional Exposure Ledger (Read by participating stores & Platform Admin, Admin/Server write)
    match /partner_picks_exposure_ledger/{partnershipId} {
      allow get: if isSignedIn() && isValidId(partnershipId) && isAdmin();
      allow list: if isSignedIn() && isAdmin();
      allow create: if isAdmin() && isValidId(partnershipId) && incoming().partnershipId == partnershipId && isValidPartnerPicksExposureLedger(incoming());
      allow update: if isAdmin() && isValidId(partnershipId) && isValidPartnerPicksExposureLedger(incoming())
        && incoming().partnershipId == existing().partnershipId
        && incoming().storeAId == existing().storeAId
        && incoming().storeBId == existing().storeBId
        && incoming().diff(existing()).affectedKeys().hasOnly(['directionAOnB', 'directionBOnA', 'updatedAt']);
      allow delete: if false;
    }

    // 15. Partner Picks Per-Channel Analytics Events (Append-only idempotent telemetry, zero update/delete)
    match /partner_picks_analytics_events/{eventId} {
      allow get: if isAdmin() && isValidId(eventId);
      allow list: if isAdmin() && resource.data.id >= '';
      allow create: if isValidId(eventId) && incoming().id == eventId && isValidPartnerPicksAnalyticsEvent(incoming());
      allow update, delete: if false;
    }
  }
}
